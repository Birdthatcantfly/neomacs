;; -*- lexical-binding: t -*-
;; Serial compiled-call twins; expected bytes come only from GNU 31.1.
(unless (and (string= emacs-version "31.1")
             (equal (getenv "NEOVM_ORACLE_MODE") "refresh")
             (equal (getenv "UPDATE_EXPECT") "1"))
  (error "C4 cache oracle requires GNU 31.1 and explicit refresh mode"))
(require 'bytecomp)
(defun p3sym-c4-cache-out (value) (prin1 value) (terpri))
(setq p3sym-c4-cache-old (byte-compile '(lambda () 73))
      p3sym-c4-cache-new '(lambda () 97))
(fset 'p3sym-c4-cache-leaf p3sym-c4-cache-old)
(fset 'p3sym-c4-cache-other p3sym-c4-cache-old)
(setq p3sym-c4-cache-caller
      (byte-compile '(lambda () (p3sym-c4-cache-leaf))))
(p3sym-c4-cache-out (list (funcall p3sym-c4-cache-caller)
                          (funcall 'p3sym-c4-cache-leaf)))
(p3sym-c4-cache-out
 (list (eq (fset 'p3sym-c4-cache-leaf p3sym-c4-cache-old)
           p3sym-c4-cache-old)
       (funcall p3sym-c4-cache-caller)
       (funcall 'p3sym-c4-cache-leaf)))
(fset 'p3sym-c4-cache-other p3sym-c4-cache-new)
(p3sym-c4-cache-out (list (funcall p3sym-c4-cache-caller)
                          (funcall 'p3sym-c4-cache-other)))
(fset 'p3sym-c4-cache-leaf p3sym-c4-cache-new)
(p3sym-c4-cache-out (list (funcall p3sym-c4-cache-old)
                          (funcall p3sym-c4-cache-caller)
                          (funcall 'p3sym-c4-cache-leaf)))
(fmakunbound 'p3sym-c4-cache-leaf)
(p3sym-c4-cache-out
 (list (condition-case condition (funcall p3sym-c4-cache-caller)
         (void-function (car condition)))
       (funcall p3sym-c4-cache-old)))
(fset 'p3sym-c4-cache-leaf p3sym-c4-cache-new)
(p3sym-c4-cache-out (list (funcall p3sym-c4-cache-caller)
                          (funcall 'p3sym-c4-cache-leaf)))
